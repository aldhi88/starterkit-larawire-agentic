{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "aldhi88/starterkit-larawire-agentic",
    "description": "An Agentic AI-ready Laravel and Livewire starter kit for secure, modular internal company applications.",
    "keywords": [
        "laravel",
        "livewire",
        "agentic-ai",
        "ai-ready",
        "starter-kit",
        "admin",
        "internal-application"
    ],
    "type": "library",
    "license": "proprietary",
    "homepage": "https://github.com/aldhi88/starterkit-larawire-agentic",
    "authors": [
        {
            "name": "Aldhi88",
            "homepage": "https://github.com/aldhi88"
        }
    ],
    "support": {
        "issues": "https://github.com/aldhi88/starterkit-larawire-agentic/issues",
        "source": "https://github.com/aldhi88/starterkit-larawire-agentic"
    },
    "require": {
        "php": ">=8.3",
        "ext-intl": "*",
        "ext-zip": "*",
        "dedoc/scramble": "^0.13.36",
        "laravel-lang/common": "^6.8",
        "laravel/framework": ">=13.8 <14.0",
        "livewire/livewire": "^4.3",
        "power-components/livewire-powergrid": "^6.10"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "larastan/larastan": "^3.9",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Aldhi88\\StarterKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aldhi88\\StarterKit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aldhi88\\StarterKit\\Providers\\Starter\\StarterInstallerServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "test": "pest --compact",
        "check-package": "composer validate --strict"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

{
    "schema_version": 1,
    "purpose": "Machine-readable completion contract for every Starterkit Larawire theme integration.",
    "one_instruction": {
        "intake_pattern": "theme-intake/<theme-key>/",
        "canonical_prompt": "Integrasikan theme <theme-key> dari theme-intake/<theme-key> sampai siap dipilih installer.",
        "default_output": "core package integration",
        "source_provider": "dedicated public GitHub template repository"
    },
    "required_layouts": [
        "vertical",
        "horizontal"
    ],
    "required_docs": [
        "source.json",
        "template.md",
        "runtime-map.md",
        "source-index.json",
        "component-manifest.json",
        "asset-manifest.json"
    ],
    "required_components": [
        "layout.vertical",
        "layout.horizontal",
        "navigation.primary",
        "navigation.account-menu",
        "navigation.app-switcher",
        "auth.login",
        "auth.confirm-password",
        "auth.lock-screen",
        "error.http",
        "page.header",
        "content.card",
        "content.statistic",
        "content.empty-state",
        "identity.avatar",
        "status.badge",
        "action.button",
        "form.input",
        "form.textarea",
        "form.select",
        "form.file",
        "form.validation",
        "form.checkbox",
        "form.radio",
        "form.switch",
        "interaction.tabs",
        "interaction.accordion",
        "interaction.dropdown",
        "feedback.alert",
        "feedback.toast",
        "feedback.modal",
        "feedback.destructive-confirmation",
        "table.powergrid",
        "table.toolbar",
        "table.search",
        "table.filter.text",
        "table.filter.select",
        "table.filter.date-range",
        "table.sort",
        "table.selection",
        "table.bulk-action",
        "table.horizontal-scroll",
        "table.per-page",
        "table.record-count",
        "table.pagination"
    ],
    "required_runtime_groups": [
        "auth",
        "errors",
        "logs",
        "powergrid",
        "profile",
        "settings",
        "templates/components",
        "templates/layouts",
        "user-management"
    ],
    "required_runtime_files": [
        "starter/auth/confirm-password.blade.php",
        "starter/auth/lock-screen.blade.php",
        "starter/auth/login.blade.php",
        "starter/errors/400.blade.php",
        "starter/errors/401.blade.php",
        "starter/errors/403.blade.php",
        "starter/errors/404.blade.php",
        "starter/errors/405.blade.php",
        "starter/errors/408.blade.php",
        "starter/errors/419.blade.php",
        "starter/errors/422.blade.php",
        "starter/errors/429.blade.php",
        "starter/errors/4xx.blade.php",
        "starter/errors/500.blade.php",
        "starter/errors/503.blade.php",
        "starter/errors/5xx.blade.php",
        "starter/errors/layout.blade.php",
        "starter/logs/activity-log-index.blade.php",
        "starter/logs/powergrid/activity-logs-toolbar.blade.php",
        "starter/logs/powergrid/logs-row-actions.blade.php",
        "starter/powergrid/footer.blade.php",
        "starter/powergrid/pagination.blade.php",
        "starter/powergrid/table-base.blade.php",
        "starter/profile/edit-my-profile.blade.php",
        "starter/settings/client-profile.blade.php",
        "starter/settings/security-settings.blade.php",
        "starter/settings/settings-index.blade.php",
        "starter/templates/components/alert-modal.blade.php",
        "starter/templates/components/alert.blade.php",
        "starter/templates/components/danger-modal.blade.php",
        "starter/templates/components/danger-password-modal.blade.php",
        "starter/templates/components/success-modal.blade.php",
        "starter/templates/components/toast.blade.php",
        "starter/templates/layouts/account-menu.blade.php",
        "starter/templates/layouts/app-switcher.blade.php",
        "starter/templates/layouts/app.blade.php",
        "starter/templates/layouts/auth.blade.php",
        "starter/templates/layouts/icon.blade.php",
        "starter/templates/layouts/landing.blade.php",
        "starter/templates/layouts/menu-item-horizontal.blade.php",
        "starter/templates/layouts/menu-item.blade.php",
        "starter/templates/layouts/navigation/horizontal.blade.php",
        "starter/templates/layouts/navigation/vertical.blade.php",
        "starter/templates/session-expired.blade.php",
        "starter/user-management/powergrid/roles-row-actions.blade.php",
        "starter/user-management/powergrid/roles-toolbar.blade.php",
        "starter/user-management/powergrid/users-row-actions.blade.php",
        "starter/user-management/powergrid/users-toolbar.blade.php",
        "starter/user-management/role-form.blade.php",
        "starter/user-management/roles.blade.php",
        "starter/user-management/user-form.blade.php",
        "starter/user-management/users.blade.php"
    ],
    "asset_policy": {
        "dependency_closure_only": true,
        "manifest_every_runtime_file": true,
        "forbidden_by_default": [
            "node_modules",
            "source maps",
            "build caches",
            "demo databases and data",
            "unused demo pages",
            "unused plugins",
            "unused alternate layouts, colors, RTL, and dark bundles",
            "duplicate minified and unminified assets"
        ]
    },
    "completion_gates": [
        "license-and-distribution-decision",
        "complete-source-index",
        "complete-component-manifest",
        "exact-runtime-asset-manifest",
        "no-cross-theme-presentation-residue",
        "package-tests-and-static-analysis",
        "fresh-host-composer-install",
        "vertical-browser-matrix",
        "horizontal-browser-matrix",
        "responsive-and-overflow-browser-matrix",
        "no-unexplained-todo-or-known-core-ui-bug"
    ]
}

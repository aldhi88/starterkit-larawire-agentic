    "asset_policy": {
        "dependency_closure_only": true,
        "manifest_every_runtime_file": true,
        "forbidden_by_default": [
            "node_modules",
            "source maps",
            "build caches",
            "demo databases and data",
            "unused demo pages",
            "unused plugins",
            "unused alternate layouts, colors, RTL, and dark bundles",
            "duplicate minified and unminified assets"
        ]
    },
        "completion_gates": [
        "valid-current-run-verification-ledger",
        "verification-ledger-validator-passes",
        "current-input-fingerprints",
        "license-and-distribution-decision",
        "complete-source-index",
        "complete-component-manifest",
        "exact-runtime-asset-manifest",
        "native-component-evidence",
        "compiled-class-and-custom-css-audit",
        "side-by-side-structural-parity",
        "no-cross-theme-presentation-residue",
        "package-tests-and-static-analysis",
        "fresh-host-composer-install",
        "comparison-host-dry-run-clean",
        "vertical-browser-matrix",
        "horizontal-browser-matrix",
        "responsive-and-overflow-browser-matrix",
        "full-page-state-matrix-without-sampling-or-skips",
        "screenshot-and-computed-metrics-per-browser-row",
        "objective-geometry-tolerances",
        "computed-layout-and-overflow-audit",
        "archive-manifest-checksum-consistency",
        "all-affected-project-documentation-consistency",
        "template-repository-archive-and-notices-current",
        "fresh-runtime-post-package-browser-smoke",
        "no-unexplained-todo-or-known-core-ui-bug"
    ]
